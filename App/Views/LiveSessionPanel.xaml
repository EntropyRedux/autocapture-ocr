<UserControl x:Class="AutoCaptureOCR.App.Views.LiveSessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181825" Foreground="#CDD6F4">
    <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Stats -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pulsing Live Dot -->
                        <Ellipse Width="10" Height="10" Fill="#F38BA8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionTypeTextBlock" Text="LIVE SESSION" FontWeight="Bold" FontSize="13" Foreground="#F38BA8"/>
                        <TextBlock x:Name="SessionNameTextBlock" Text=" - Active Archival" FontSize="13" Foreground="#CDD6F4" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StatsTextBlock" Text="Turns: 0 | Words: 0 | Duration: 00:00" FontSize="11" Foreground="#A6ADC8" Margin="18,3,0,0"/>
                </StackPanel>

                <!-- Stop Button -->
                <Button Grid.Column="1" Content="⏹ Stop Session" Height="30" Padding="12,0"
                        Background="#F38BA8" Foreground="#11111B" FontWeight="SemiBold"
                        BorderThickness="0" Click="StopButton_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Live Text Feed / Preview -->
            <Border Grid.Row="1" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="10">
                <ScrollViewer x:Name="TextScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LiveTextBox" Background="Transparent" Foreground="#CDD6F4"
                             BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas, Segoe UI" FontSize="12"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
