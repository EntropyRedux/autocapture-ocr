<Window x:Class="AutoCaptureOCR.App.Views.ChatCaptureSettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatCapture Settings" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="💬 ChatCapture Configuration" FontSize="18" FontWeight="SemiBold" Foreground="#89B4FA"/>
            <TextBlock Text="Passive background archival settings for AI chat conversations."
                       FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Enable Toggle -->
                <CheckBox x:Name="EnabledCheckBox" Content="Enable ChatCapture Subsystem"
                          Foreground="#CDD6F4" FontSize="13" Margin="0,0,0,14"/>

                <!-- WebSocket Port -->
                <TextBlock Text="WebSocket Bridge Port:" Foreground="#CDD6F4" FontWeight="Medium" Margin="0,0,0,4"/>
                <TextBox x:Name="PortTextBox" Text="49281" Padding="8,6" Background="#313244"
                         Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                         FontSize="13" Margin="0,0,0,14"/>

                <!-- Auto Start -->
                <CheckBox x:Name="AutoStartCheckBox" Content="Auto-start WebSocket bridge on application launch"
                          Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,14"/>

                <!-- Monitored Hostnames -->
                <TextBlock Text="Monitored Hostnames (comma-separated):" Foreground="#CDD6F4" FontWeight="Medium" Margin="0,0,0,4"/>
                <TextBox x:Name="HostnamesTextBox" Text="claude.ai, chatgpt.com" Padding="8,6" Background="#313244"
                         Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                         FontSize="13" Margin="0,0,0,14"/>

                <!-- Extension Setup Banner -->
                <Border Background="#181825" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="🧩 Browser Extension Setup" FontWeight="Bold" Foreground="#89B4FA" FontSize="12"/>
                        <TextBlock Text="To archive conversations from Chrome or Edge:" Foreground="#CDD6F4" FontSize="11" Margin="0,4,0,2"/>
                        <TextBlock Text="1. Open chrome://extensions and enable 'Developer mode'." Foreground="#A6ADC8" FontSize="11"/>
                        <TextBlock Text="2. Click 'Load unpacked' and select the 'Extension' folder." Foreground="#A6ADC8" FontSize="11"/>
                        <TextBlock Text="3. Open Claude.ai or ChatGPT to begin streaming turns." Foreground="#A6ADC8" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Save / Cancel Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="85" Height="32" Margin="0,0,8,0"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                    Click="CancelButton_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Save Settings" Width="110" Height="32"
                    Background="#89B4FA" Foreground="#11111B" FontWeight="SemiBold" BorderThickness="0"
                    Click="SaveButton_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
