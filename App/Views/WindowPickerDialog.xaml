<Window x:Class="AutoCaptureOCR.App.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Target Window" Height="480" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title / Subtitle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select a Window" FontSize="18" FontWeight="SemiBold" Foreground="#89B4FA"/>
            <TextBlock Text="Choose a target window for real-time video capture or UIA chat extraction."
                       FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search / Filter -->
        <TextBox x:Name="SearchTextBox" Grid.Row="1" Margin="0,0,0,12"
                 Padding="8,6" Background="#313244" Foreground="#CDD6F4"
                 BorderBrush="#45475A" BorderThickness="1"
                 FontSize="13" TextChanged="SearchTextBox_TextChanged">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Window List -->
        <Border Grid.Row="2" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="WindowsListBox" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="WindowsListBox_MouseDoubleClick"
                     SelectionChanged="WindowsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="2" CornerRadius="4" Background="#313244">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="#A6ADC8"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding HandleHex}" FontSize="10" Foreground="#6C7086" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Refresh" Width="85" Height="32" Margin="0,0,8,0"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                    Click="RefreshButton_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancel" Width="85" Height="32" Margin="0,0,8,0"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                    Click="CancelButton_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="SelectButton" Content="Select Window" Width="120" Height="32"
                    Background="#89B4FA" Foreground="#11111B" FontWeight="SemiBold" BorderThickness="0"
                    IsEnabled="False" Click="SelectButton_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
